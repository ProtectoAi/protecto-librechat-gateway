# Only the image reference and published port are read from this file.
# Every other gateway setting (Protecto connection, model catalog, async
# masking, OCR, RAG embeddings) is inlined as editable values directly in
# compose.remote.yml's environment block - edit that file instead.

# Full private-registry image reference published from the laptop.
GATEWAY_IMAGE=YOUR_DOCKER_NAMESPACE/protecto_librechat_gateway:1.0.0
GATEWAY_PORT=8000
