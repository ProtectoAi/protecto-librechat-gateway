# Runtime feature flags. Copy this file to .env only when using Docker Compose.
MASK_TOOL_RESULTS=true
NORMALIZE_TOOL_CALL_IDS=true
LOG_SSE=false
BUFFER_TEXT_WHEN_TOOLS=false

# Gateway-only Protecto settings. Do not configure these as LibreChat headers.
PROTECTO_URL=https://protecto.example.com
PROTECTO_MASTER_TOKEN=replace-with-protecto-master-token
PROTECTO_NAMESPACE=librechat_namespace_vault

# Large-payload masking. Poll delay and retries use the threshold as their
# baseline and can be scaled independently according to actual payload size.
ASYNC_MASK_THRESHOLD_KB=10
ASYNC_MASK_POLL_SECONDS=10
ASYNC_MASK_MAX_RETRIES=6
ASYNC_MASK_SCALE_POLL_SECONDS=true
ASYNC_MASK_SCALE_RETRIES=true

# Two-level JSON model catalog assembled as provider:model at runtime.
# X-Chat-Name is added dynamically for the LibreChat display model ID.
GATEWAY_MODEL_PROVIDERS_MODELS={"OpenAI":["gpt-5.6","gpt-5.6-terra","gpt-5.6-luna","gpt-5.5"],"Gemini":["gemini-3.6-flash","gemini-3.5-flash","gemini-3.5-flash-lite"]}

# LibreChat RAG sends RAG_OPENAI_API_KEY as the Bearer credential. The gateway
# uses that incoming credential transiently when forwarding masked input.
OPENAI_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
RAG_PROTECTO_USER_ID=librechat-rag-service

# Local OCR; see OCR.md. Generate a shared key and also set it in LibreChat.
# Kept disabled until an administrator configures a key (minimum 32 bytes).
OCR_ENABLED=false
OCR_API_KEY=
OCR_LANGUAGES=eng
OCR_PDF_MODE=auto
OCR_MAX_FILE_MB=20
OCR_MAX_PAGES=50
OCR_TIMEOUT_SECONDS=180
OCR_MAX_CONCURRENT=1
OCR_MAX_IMAGE_PIXELS=40000000
OCR_RENDER_MAX_SIDE=4000
OCR_MAX_TEXT_CHARS=2000000
OCR_WORKER_MEMORY_MB=1024
